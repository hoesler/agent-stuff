{
  "name": "hoesler",
  "version": "1.0.0",
  "description": "Christoph's coding agent commands, skills, extensions, and themes",
  "repository": {
    "type": "git",
    "url": "https://github.com/hoesler/agent-stuff.git"
  },
  "readme": "README.md",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill",
    "pi-theme"
  ],
  "pi": {
    "extensions": [
      "./pi/extensions"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./pi/themes"
    ],
    "prompts": [
      "./pi/commands"
    ]
  },
  "dependencies": {
    "diff": "^8.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.80.7",
    "@earendil-works/pi-coding-agent": "^0.80.7",
    "@earendil-works/pi-tui": "^0.80.7",
    "typescript": "^6.0.3",
    "@types/node": "^24.12.0"
  },
  "scripts": {
    "test": "node --test pi/extensions/model-modes/*.test.ts pi/extensions/subagent/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  }
}
